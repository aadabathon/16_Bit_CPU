// cpu16_control_fsm — state (bubble) diagram.
// Render: dot -Tsvg control_fsm.dot -o ../control_fsm.svg
// Bubble text: state name, then the register transfer performed in that state.
// Arc labels are next-state conditions; unlabeled arcs are unconditional.
digraph cpu16_control_fsm {
  graph [bgcolor="white", rankdir=TB, nodesep=0.35, ranksep=0.55, pad=0.3,
         fontname="Helvetica", fontsize=11, newrank=true];
  node  [shape=circle, fixedsize=true, width=1.55, style=filled, fillcolor="#f5f7fb",
         color="#334155", penwidth=1.4, fontname="Helvetica", fontsize=10.5];
  edge  [color="#334155", fontname="Helvetica", fontsize=10, arrowsize=0.75, penwidth=1.1];

  // Reset entry (synchronous: rst forces S_IF0 from any state)
  rst [shape=plaintext, style="", fixedsize=false, width=0, label="rst\n(from any state)", fontsize=10];

  // Defaults box (ECE551 convention: every output defaults low unless asserted)
  defaults [shape=box, style="rounded,dashed", fixedsize=false, color="#64748b", fillcolor="white",
            fontsize=9.5, margin="0.15,0.08", label=<
<b>Default outputs (every state)</b><br/>
pc_we = ir_we = mar_we = mdr_we = 0<br/>
reg_we = flag_we = mem_we = 0<br/>
reg_dst = 0, ra2_sel = 0, wb_sel = 0<br/>
alu_op = 0, alu_a_sel = 0, alu_b_sel = 0<br/>
pc_src_sel = 0, mar_src_sel = 0<br/>
<i>* = output depends on IR or N/Z/P</i>>];

  // ---- Fetch / decode ----
  IF0   [label=<<b>S_IF0</b><br/>MAR ← PC>, fillcolor="#e0ecff"];
  IF1   [label=<<b>S_IF1</b><br/>wait<br/>(SRAM read)>, fillcolor="#e0ecff"];
  IF2   [label=<<b>S_IF2</b><br/>IR ← M[MAR]<br/>PC ← PC + 1>, fillcolor="#e0ecff"];
  ID    [label=<<b>S_ID</b><br/>decode IR>, fillcolor="#e0ecff"];

  // ---- Execute ----
  EXALU [label=<<b>S_EX_ALU</b><br/>DR ← A op B *<br/>NZP ← result *>];
  EXEA  [label=<<b>S_EX_EA</b><br/>MAR ← EA *>];
  RD0   [label=<<b>S_MEM_RD0</b><br/>wait<br/>(SRAM read)>, fillcolor="#fff4e0"];
  RD1   [label=<<b>S_MEM_RD1</b><br/>MDR ← M[MAR]>, fillcolor="#fff4e0"];
  WBLD  [label=<<b>S_WB_LD</b><br/>DR ← MDR>, fillcolor="#fff4e0"];
  WR0   [label=<<b>S_MEM_WR0</b><br/>M[MAR] ← SR>, fillcolor="#fff4e0"];
  EXBR  [label=<<b>S_EX_BR</b><br/>if (nzp &amp; NZP)<br/>PC ← PC + off9 *>];
  EXJMP [label=<<b>S_EX_JMP</b><br/>PC ← BaseR<br/>or R7 (RET) *>];
  EXJSR [label=<<b>S_EX_JSR</b><br/>R7 ← PC<br/>PC ← PC + off11<br/>or BaseR *>];
  EXTRAP[label=<<b>S_EX_TRAP</b><br/>R7 ← PC<br/>PC ← ZEXT(tv12)>];

  { rank=same; rst; IF0; IF1; IF2; ID; }
  { rank=same; EXALU; EXEA; EXBR; EXJMP; EXJSR; EXTRAP; }
  { rank=same; RD0; RD1; WBLD; WR0; }

  rst -> IF0 [style=bold];
  IF0 -> IF1;
  IF1 -> IF2;
  IF2 -> ID;

  ID -> EXALU  [label="ALU0, ALU1,\nADDI, ANDI, LEA"];
  ID -> EXEA   [label="LD, LDR,\nST, STR"];
  ID -> EXBR   [label="BR"];
  ID -> EXJMP  [label="JMP, RET"];
  ID -> EXJSR  [label="JSR"];
  ID -> EXTRAP [label="TRAP"];
  ID -> IF0    [label="xE, xF\n(undefined)", style=dashed, constraint=false];

  EXEA -> RD0 [label="LD, LDR"];
  EXEA -> WR0 [label="ST, STR"];
  WBLD -> WR0 [style=invis];
  RD0  -> RD1;
  RD1  -> WBLD;

  // Return-to-fetch arcs collected on a shared bus point to keep the drawing readable
  back [shape=point, width=0.08, style=filled, fillcolor="#334155", label=""];
  EXALU  -> back [arrowhead=none];
  EXBR   -> back [arrowhead=none];
  EXJMP  -> back [arrowhead=none];
  EXJSR  -> back [arrowhead=none];
  EXTRAP -> back [arrowhead=none];
  WBLD   -> back [arrowhead=none];
  WR0    -> back [arrowhead=none];
  back -> IF0 [label="  next\n  instruction", constraint=false, penwidth=1.6];

  { rank=sink; back; defaults; }
}
